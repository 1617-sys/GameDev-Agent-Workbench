# LLM provider config. Use an OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_ENABLE_MOCK_FALLBACK=false
SIMULATION_SERVICE_BASE_URL=http://simulation-service:8090
SIMULATION_SERVICE_INTERNAL_TOKEN=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_INTERNAL_TOKEN
