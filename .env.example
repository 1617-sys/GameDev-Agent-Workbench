## `start-docker.ps1` creates .env with random local credentials on first use.
## Do not put real credentials in this tracked template.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_24_PLUS_CHARACTER_LOCAL_ROOT_PASSWORD
MYSQL_DATABASE=gamedev_agent_workbench
DB_USERNAME=gamedev_app
DB_PASSWORD=REPLACE_WITH_A_RANDOM_24_PLUS_CHARACTER_LOCAL_APP_PASSWORD

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_JWT_SECRET
JWT_EXPIRE_SECONDS=3600

# Redis is internal to Compose and must still use a random password.
REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_24_PLUS_CHARACTER_LOCAL_REDIS_PASSWORD

PYTHON_AGENT_BASE_URL=http://python-agent:8000
PYTHON_AGENT_INTERNAL_TOKEN=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_INTERNAL_TOKEN
SIMULATION_SERVICE_BASE_URL=http://simulation-service:8090
SIMULATION_SERVICE_INTERNAL_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_INTERNAL_TOKEN
SIMULATION_SESSION_TTL_MS=300000
SIMULATION_MAX_SESSIONS=100
GAME_BUILD_BASE_URL=http://localhost:5173

# Cocos Creator V5 playable-build pipeline. Adjust the host paths on other machines.
COCOS_CREATOR_EXECUTABLE=C:\ProgramData\cocos\editors\Creator\3.8.8\CocosCreator.exe
COCOS_RUNTIME_PROJECT=F:\coe\java\GameDev Agent Workbench\cocos-runtime-shell
COCOS_BUILD_WORK_ROOT=F:\coe\java\GameDev Agent Workbench\tmp\cocos-build-work
COCOS_ARTIFACT_ROOT=F:\coe\java\GameDev Agent Workbench\tmp\playable-artifacts
COCOS_SUCCESS_EXIT_CODES=36

# Java one-shot design generation now uses Spring AI by default. Set APP_AI_PROVIDER=python
# only for the temporary rollback path or deterministic Python mock fallback.
APP_AI_PROVIDER=spring-ai
# Director defaults to user-controlled Spring AI Tool Calling. Set to python only for rollback.
DIRECTOR_DECISION_PROVIDER=spring-ai
DIRECTOR_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_ATTEMPTS=3
LLM_ENABLE_MOCK_FALLBACK=true
PLAYER_API_TIMEOUT_MS=120000
PLAYER_RUN_RECOVERY_DELAY_MS=30000

# RabbitMQ is only required by the R3 async profile and Docker Compose environment.
# It is internal-only: neither AMQP nor the management UI is exposed to the host.
RABBITMQ_USERNAME=gamedev_app
RABBITMQ_PASSWORD=REPLACE_WITH_A_RANDOM_24_PLUS_CHARACTER_LOCAL_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/

# Optional loopback-only host port overrides for a machine with occupied defaults.
# MYSQL_HOST_PORT=3307
# REDIS_HOST_PORT=6380
# RABBITMQ_HOST_PORT=5673
# PYTHON_AGENT_HOST_PORT=8000
# BACKEND_HOST_PORT=8080
# FRONTEND_HOST_PORT=5173
