MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_ROOT_PASSWORD
DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_JWT_SECRET
JWT_EXPIRE_SECONDS=86400

PYTHON_AGENT_BASE_URL=http://python-agent:8000
GAME_BUILD_BASE_URL=http://localhost:5173

LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_ENABLE_MOCK_FALLBACK=false

# RabbitMQ is only required by the R3 async profile and Docker Compose environment.
# Local Compose exposes AMQP on 5672 and the management UI on 127.0.0.1:15672.
RABBITMQ_USERNAME=REPLACE_WITH_LOCAL_RABBITMQ_USERNAME
RABBITMQ_PASSWORD=REPLACE_WITH_LOCAL_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/
